# ------------------------------------------------------------------
# ShopSphere API environment
# Copy this file to backend/.env and update the values.
# NEVER commit your real .env file.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/shopsphere
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/shopsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere

# Use an in-memory MongoDB instance (great for a quick demo / CI).
# Requires the mongodb-memory-server dev dependency. Data is lost on restart.
# USE_MEMORY_DB=false

# Comma-separated list of allowed frontend origins.
CLIENT_URL=http://localhost:5173

# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Public base URL of this API (used to build uploaded image URLs)
API_URL=http://localhost:5000

# Rate limits (per IP). Raise AUTH_RATE_LIMIT_MAX when running the E2E suite
# repeatedly, or restart the API to reset the in-memory counters.
AUTH_RATE_LIMIT_MAX=50
REGISTER_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=1500

# Seed script admin account. If omitted, development defaults are used.
# In production the seed script refuses to run without these values.
SEED_ADMIN_NAME=Store Administrator
SEED_ADMIN_EMAIL=admin@shopsphere.com
SEED_ADMIN_PASSWORD=Admin@12345

# Seed demo customer password (optional)
SEED_CUSTOMER_PASSWORD=Customer@123
