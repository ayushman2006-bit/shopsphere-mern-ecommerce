# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere

# Frontend address (used by CORS)
CLIENT_URL=http://localhost:5173

# Change this to any long random string
JWT_SECRET=change_this_to_a_long_random_string

# Demo accounts created by "npm run seed"
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@shopsphere.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@shopsphere.com
SEED_CUSTOMER_PASSWORD=Customer@123
